# =====================================================================
# Copie para .env.local e preencha. .env.local NAO vai para o git.
# =====================================================================

# ── Cloud SQL / Postgres ────────────────────────────────────────────
# DATABASE_URL     = dono do schema. Usado SOMENTE pelas migrations e seed.
# DATABASE_URL_APP = app_user. Usado pela aplicacao em runtime (sujeito a RLS).
DATABASE_URL=postgresql://postgres:devpass@localhost:55432/x1empresa
DATABASE_URL_APP=postgresql://app_user:devpass@localhost:55432/x1empresa

# Em desenvolvimento local (Docker) nao ha TLS. No Cloud SQL, remova esta linha.
PG_SSL=false
PG_POOL_MAX=10

# ── Firebase Web (publico por design — identifica o projeto, nao autentica) ──
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyDYhFEbrJsAElUetuUmyBRn6QZRvU-aUDU
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=cboclub-f815c.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=cboclub-f815c
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=cboclub-f815c.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=24006804989
NEXT_PUBLIC_FIREBASE_APP_ID=1:24006804989:web:b6ca1bb22c85a1d6fa4594

# ── Firebase Admin (SEGREDO — nunca commitar) ───────────────────────
# Service account do projeto: Configuracoes > Contas de servico > Gerar chave.
# Cole o JSON inteiro em uma linha, ou aponte GOOGLE_APPLICATION_CREDENTIALS
# para o arquivo .json fora do repositorio.
FIREBASE_SERVICE_ACCOUNT_JSON=
# GOOGLE_APPLICATION_CREDENTIALS=C:\caminho\fora\do\repo\service-account.json
