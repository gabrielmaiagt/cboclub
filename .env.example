# =====================================================================
# Copie para .env.local e preencha. .env.local NAO vai para o git.
# =====================================================================

# ── Firebase Web ────────────────────────────────────────────────────
# Publicas por design: identificam o projeto, nao autenticam ninguem.
# Quem protege os dados sao as Security Rules, nunca o segredo destas strings.
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyDYhFEbrJsAElUetuUmyBRn6QZRvU-aUDU
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=cboclub-f815c.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=cboclub-f815c
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=cboclub-f815c.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=24006804989
NEXT_PUBLIC_FIREBASE_APP_ID=1:24006804989:web:b6ca1bb22c85a1d6fa4594

# Aponta o SDK cliente para os emuladores locais (npm run emu)
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=true

# ── Firebase Admin (SEGREDO — nunca commitar) ───────────────────────
# Console > Configuracoes do projeto > Contas de servico > Gerar nova chave.
# Cole o JSON inteiro numa linha so. Em desenvolvimento com emulador,
# pode deixar vazio: o Admin SDK conecta sem credencial.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Necessarias apenas quando o Admin SDK fala com os emuladores
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
